# ============================================================================
# 1. STORY & METADATA GENERATION (100% Free Tier via Google AI Studio)
# Get your free key at: https://aistudio.google.com/apikey
# ============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# ============================================================================
# 2. VOICE NARRATION (100% Free via Microsoft Edge Neural TTS - No Key Needed)
# Recommended voices: en-US-AriaNeural, en-US-AnaNeural, en-GB-SoniaNeural
# ============================================================================
TTS_VOICE=en-US-AriaNeural
TTS_RATE=-5%

# ============================================================================
# 3. IMAGE GENERATION (Pollinations Gen API: https://gen.pollinations.ai)
# Get your secret key (sk_...) at: https://enter.pollinations.ai/keys
# Or run: python scripts/get_pollinations_key.py
# ============================================================================
IMAGE_PROVIDER=pollinations
POLLINATIONS_API_KEY=
POLLINATIONS_IMAGE_MODEL=black-forest-labs/flux.1-schnell
TOGETHER_API_KEY=

# ============================================================================
# 4. YOUTUBE DATA API v3 (100% Free - 10,000 daily quota units)
# Run `python scripts/get_youtube_token.py` once locally to get your Refresh Token
# ============================================================================
YOUTUBE_CLIENT_ID=your_google_oauth_client_id
YOUTUBE_CLIENT_SECRET=your_google_oauth_client_secret
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token
YOUTUBE_PRIVACY_STATUS=public
YOUTUBE_MADE_FOR_KIDS=false
YOUTUBE_UPLOAD_SHORT=true

# ============================================================================
# 5. TIKTOK UPLOAD (Supports "official", "cookies", or "auto")
# - For Official API: Set TIKTOK_CLIENT_KEY, TIKTOK_CLIENT_SECRET, TIKTOK_REFRESH_TOKEN
# - For Cookie Uploader: Export cookies from browser as JSON into TIKTOK_COOKIES_JSON
# ============================================================================
TIKTOK_UPLOAD_MODE=auto
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
TIKTOK_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE
TIKTOK_COOKIES_JSON=
